<configuration>
  <connectionStrings>
    <!-- SECURITY: the previously-committed list of per-environment production connection
         strings (DEVOO1, GKBS01, 150.241.247.x, SVG002, VIG001, MAST SYNC, GLO001) has been
         removed from source control. Per-environment connection strings should be supplied by
         the deployment environment (e.g. a Web.config transform or a secret store), not kept
         in the base config. The AES used to encrypt these is a fixed key+salt in source, so
         anything committed here is effectively plaintext — see clsEncryptDecrypt. -->
    <add name="Connections" connectionString="ypPJqLAblnVHAsF8pAEyKrBfkYg9xM5jOMGHjQhffjJpd62yW5Z2iWPYFStAqmTqxwBYDNuPrcVzw9RQ1ynGmS1sHWuWUGEHYgGdHILuUEkIcoKaq9vd7RsFt8L0hyoAX0LofiG8CafJxt3Mr27lzrZ6yRFISrs+qerbuLPj5UDUAZdKTLjmJRb5M1o4Vu8UqkvHJH0ERmYONGON2xW9zw==" providerName="System.Data.SqlClient"/>
    <!--GKBS-SERVER<add name="Connections" connectionString="ypPJqLAblnVHAsF8pAEyKrBfkYg9xM5jOMGHjQhffjJpd62yW5Z2iWPYFStAqmTqxwBYDNuPrcVzw9RQ1ynGmdZdZraA7JBeuAT6FNkrjFfOR4Akbq/ZLK5OWP7Eq+/3SPKPyxJEmaOOa9c9KTdKEh7yV+KOueSPE1XUGF8aQtsW5A9Tezitt2EPPwGfVes68jdDK3n4wJlyA2/3qLm5pg==" providerName="System.Data.SqlClient" />-->
    <add name="ShinecodeConnection" connectionString="it0ukaj0E3e2csaJAEmq6qmMDj84w2YQtqjF0lmic8xJ9VevNN6ISZu8Re9TbzKGJtv4TT7ZSb/dPAEtBvg5NEMe/fjSTJ5xbxWhq3Jn2kcDGQYJfCYBM/NpjPa8Q5S+Hvcz/fQjLpb2tSjY05hzgjXeYYLyCarsZEtph7I86t1iRU+cmHG2NBczEvZo6AeQZcxNOK4+bhITzMHHGUG88znLE2TgwwhnUEnw0VhEQvc=" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <!-- Shared secret (32+ chars) the MVC UI server must send in X-Shine-Ui-Key to redeem login
         tickets (POST api/validatepermissions/redeem). Must equal the UI's UiServerApiKey.
         Preferred: set the SHINE_UI_API_KEY environment variable on the server instead.
         NEVER commit a real value. Ticket redemption fails closed while this is empty. -->
    <add key="UiServerApiKey" value=""/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <add key="SupportFilePath" value="D:\\HOST\\NewWebShineSupport\\"/>
    <add key="ValidIssuer" value="https://localhost:44396/"/>
    <add key="ValidAudience" value="https://localhost:44326/"/>
    <add key="AllowedOrigins" value="https://localhost:44326"/>
    <add key="email" value="shineasst@gmail.com"/>
    <add key="smtphost" value="smtp.gmail.com"/>
    <add key="passkey" value="/5A4g9Nre3Rfz96hUxtFX7HEpJr9zsH79wwo8MuitsjyQeAClSQROGW4pRtKDlYk"/>
    <add key="AuthTokenExpiresInMins" value="60"/>
    <add key="RefreshTokenExpiresInDays" value="2"/>
    <add key="MasterSyncDB" value="WSHINE_DEV001_APR2024"/>
    <!--
      JwtSecretKey: AES-encrypted JWT signing key (same encryption as connection strings).
      To generate: use clsEncryptDecrypt.Encrypt("your-base64-key") and paste the result here.
      If this key is absent the code falls back to the previously hardcoded key so existing
      tokens remain valid until this entry is populated.
    -->    
    <add key="JwtSecretKey" value="OXp84F5PVg5XscbVDa0VQxbjw8WUWYbc8CiVg2KZi5fVtODNN31/CRtf5VPFc4cEzwptVfa8Nvy90mSxhdX3nT84dqMqYRvw6OkheFA07vPOKMIMbpS04kHUzHMWDCQQ"/>
    <!--
      QueryTimeoutSeconds: SQL command timeout in seconds (0 = infinite, default 120).
      Increase for known long-running report SPs; set per environment as needed.
    -->
    <add key="QueryTimeoutSeconds" value="120"/>
    <!--
      CacheSpParameters: when true (default) the DAL derives each stored procedure's
      parameter metadata once and caches it, avoiding a catalog round-trip to SQL Server
      on every call. Set to "false" only if stored-procedure signatures change at runtime
      (requires an app restart to pick up new signatures when caching is on).
    -->
    <add key="CacheSpParameters" value="true"/>
  </appSettings>
  <system.web>
    <!-- debug MUST be false in production: enables optimizations and prevents detailed
         error pages from leaking source/stack info. Set to true only on dev machines. -->
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" maxRequestLength="2097152"/>
    <identity impersonate="false"/>
  </system.web>
